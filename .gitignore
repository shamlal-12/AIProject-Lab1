# Heavy Datasets & Raw Data (Keep directory structures tracked via .gitkeep)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Execution & Runtime Logs
logs/*
!logs/.gitkeep
*.log

# IDE & System Files
